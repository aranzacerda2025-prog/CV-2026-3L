        "#pip install easyocr\n",
        "\n",
        "import ssl\n",
        "import easyocr\n",
        "\n",
        "ssl._create_default_hllps_context=ssl._create_unverified_context\n",
        "reader = easyocr.Reader(['es'])\n",
        "\n",
        "resultado = reader.readtext('IMG_7411.jpeg', detail=0)\n",
        "\n",
        "for linea in resultado:\n",
        "     print(linea)"
